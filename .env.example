# ==========================================
# COOLIFY PRODUCTION ENVIRONMENT TEMPLATE
# ==========================================

# Required. Indicates production environment.
NODE_ENV=production

# Required. The primary domain of your application.
NEXT_PUBLIC_APP_URL=https://paylaz.nl

# Required. NextAuth URL should match your primary domain.
NEXTAUTH_URL=https://paylaz.nl

# Required behind Traefik/reverse proxy for secure cookies
AUTH_TRUST_HOST=true

# Required. NextAuth session encryption key. Run `openssl rand -base64 32` to generate.
NEXTAUTH_SECRET=replace_me

# Required. Neon Database Unpooled Connection URL. Used for transactions.
DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require

# Required. Neon Database Pooled Connection URL. Used for general queries.
POSTGRES_PRISMA_URL=postgresql://user:pass@host-pooler/db...

# Required. API Key encryption key. Run `openssl rand -hex 32` to generate.
ENCRYPTION_KEY=replace_me

# Required. Secures your cron job endpoints from unauthorized execution.
CRON_SECRET=replace_me

# Required. PayPal Environment ('sandbox' or 'production').
PAYPAL_ENV=production

# Optional. Fallback webhook id used to verify inbound PayPal webhooks when the
# merchant account row has no paypal_webhook_id of its own. Prefer setting
# merchant_accounts.paypal_webhook_id per account — a single env var cannot
# cover two PayPal apps.
# PAYPAL_WEBHOOK_ID=

# Optional, NEVER in production. Set to 1 to accept PayPal webhooks that could
# not be verified because no webhook id is configured. Without it such webhooks
# are rejected. Only for local development: while it is on, anyone who can reach
# /api/webhook/paypal can drive a transaction to COMPLETED, REFUNDED or DISPUTED.
# It is ignored outright on a production deployment.
# PAYPAL_WEBHOOK_ALLOW_UNVERIFIED=1

# Required. HMAC secret used for execution links.
EXECUTE_HMAC_SECRET=replace_me

# Optional. Vercel API token for legacy domain onboarding if still used.
VERCEL_API_TOKEN=replace_me

# Optional. Telegram Bot for alert notifications.
TELEGRAM_BOT_TOKEN=replace_me
