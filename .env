# ==============================================================================
# .env — Shared / Non-Secret Configuration
# Commit this file. Put real secrets in .env.local (gitignored).
# ==============================================================================

# ─── NextAuth.js ──────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000

# ─── PayPal ───────────────────────────────────────────────────────────────────
PAYPAL_ENV=sandbox

# ─── Resend (Transactional Email) ─────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=Gateway <noreply@yourdomain.com>

# ─── Application URL ──────────────────────────────────────────────────────────
# Used in emails and callbacks. Set to your production domain in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000
