# ==============================================================================
# .env — BẢN MẪU CÁC BIẾN MÔI TRƯỜNG CỦA HỆ THỐNG
# (Lưu ý: Các biến nhạy cảm hoặc pass database nên được lưu ở file .env.local)
# ==============================================================================

# ─── NEXTAUTH & SECURITY ──────────────────────────────────────────────────────
# NEXTAUTH_URL: URL gốc của website. Ở local là http://localhost:3000, khi deploy lên Vercel chỉnh thành domain xịn.
# Set in Vercel env vars for production (https://www.gooytoy.com)
# Uncomment for local development only:
# NEXTAUTH_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# NEXTAUTH_SECRET: Khóa dùng để ký phiên (Session JWT) của NextAuth. Có thể tự sinh ngẫu nhiên.
# Lấy bằng cách: Chạy lệnh `openssl rand -base64 32` trong terminal.
# NEXTAUTH_SECRET=

# ENCRYPTION_KEY: Khóa bảo mật sâu dùng để mã hóa API Key của khách hàng bằng thuật toán AES-256-GCM.
# Lấy bằng cách: Sinh dải hex gồm 64 ký tự: `openssl rand -hex 32`
# ENCRYPTION_KEY=


# ─── NEON DATABASE (Nên đẩy vào .env.local) ───────────────────────────────────
# Các biến kết nối Database Drizzle/Prisma với Neon Serverless.
# Lấy bằng cách: Truy cập Dashboard Neon > Project > Connection String.
# POSTGRES_PRISMA_URL=
# DATABASE_URL_UNPOOLED=


# ─── CRON_SECRET (Bảo mật cho Automation) ─────────────────────────────────────
# CRON_SECRET: Header Bearer token để chặn người lạ gọi vào endpoint cron job quét dữ liệu.
# Lấy bằng cách: Vercel tự sinh nếu bạn cài đặt Cron, hoặc bạn tự bịa ra một mã cực kỳ bảo mật (VD: rand -hex 32).
# CRON_SECRET=


# ─── PAYPAL SETTINGS ──────────────────────────────────────────────────────────
# PAYPAL_ENV: `sandbox` (Kiểm thử) hoặc `production` (Thực tế). Rất quan trọng!
PAYPAL_ENV=sandbox

# Các biến dưới đây sẽ dùng làm Fallback nếu API Gateway yêu cầu (Tùy chọn)
# Lấy bằng cách: Đăng nhập PayPal Developer Dashboard > Apps & Credentials.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=


# ─── IDENTITY BUNDLE ENFORCEMENT ──────────────────────────────────────────────
# PAYMENT_IDENTITY_BUNDLE_MODE: Controls the behavior of the Payment Identity Bundle feature during checkout.
# - disabled = off
# - shadow = resolve/log only, no payload mutation
# - enforce = valid Identity Bundle item overrides buyer-facing PayPal line item
# PAYMENT_IDENTITY_BUNDLE_MODE=shadow


# ─── RESEND (GỬI EMAIL) ───────────────────────────────────────────────────────
# Dùng để gửi mail thông báo giao dịch hoặc quản trị cho hệ thống.
# Lấy bằng cách: Đăng ký resend.com -> Vô API Keys lấy mã.
# RESEND_API_KEY=re_xxxxxxxxxxx
# RESEND_FROM_EMAIL="Gateway <noreply@domain-cua-ban.com>"


# ─── VERCEL DOMAIN API (Tùy chọn - Dùng cho Shield Domain) ────────────────────
# Dùng để tự động map/tạo custom domain cho Shield Domain thông qua Vercel API.
# Lấy bằng cách: Vercel Settings > Tokens (Cho VERCEL_API_TOKEN)
#                Vercel Project > Settings > General (Cho PROJECT_ID)
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# ─── CONTACT CHANNELS (Public Landing Page) ───────────────────────────────────
NEXT_PUBLIC_CONTACT_TELEGRAM_URL=https://telegram.me/mrhoibeo
NEXT_PUBLIC_CONTACT_WHATSAPP_URL=
NEXT_PUBLIC_CONTACT_MESSENGER_URL=
NEXT_PUBLIC_CONTACT_ZALO_URL=
NEXT_PUBLIC_CONTACT_WECHAT_ID=
NEXT_PUBLIC_CONTACT_WECHAT_QR_URL=
