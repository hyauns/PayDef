generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                                                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                             String               @unique @db.Citext
  password_hash                                     String
  role                                              user_role            @default(MERCHANT)
  tenant_id                                         String?              @db.Uuid
  created_at                                        DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                        DateTime             @default(now()) @db.Timestamptz(6)
  email_change_codes                                email_change_codes[]
  fraud_blocklist                                   fraud_blocklist[]
  token_blacklist_token_blacklist_revoked_byTousers token_blacklist[]    @relation("token_blacklist_revoked_byTousers")
  token_blacklist_token_blacklist_user_idTousers    token_blacklist[]    @relation("token_blacklist_user_idTousers")
  tenants                                           Tenant?              @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id])
  @@map("users")
}

model Tenant {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  plan                String               @default("STARTER")
  status              String               @default("ACTIVE")
  owner_email         String?
  gateway_fee_percent Decimal              @default(2.00) @db.Decimal(5, 2)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime             @default(now()) @db.Timestamptz(6)
  telegram_bot_token  String?
  telegram_chat_id    String?
  rotation_strategy   String               @default("SEQUENTIAL")
  rotation_interval   Int                  @default(120)
  last_rotation_index Int                  @default(0)
  last_rotation_at    DateTime?            @default(now()) @db.Timestamptz(6)
  billing_records     billing_records[]
  merchant_accounts   MerchantAccount[]
  shield_domains      shield_domains[]
  stores              Store[]
  system_logs         system_logs[]
  transactions        Transaction[]
  users               User[]
  webhook_deliveries  webhook_deliveries[]
  webhook_events      webhook_events[]

  @@map("tenants")
}

model Store {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String               @db.Uuid
  name               String
  provider_type      String               @default("PAYPAL")
  api_key_hash       String
  webhook_url        String?
  shield_domain      String?
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  capture_mode       String               @default("INSTANT")
  checkout_flow      String?              @default("REDIRECT")
  webhook_secret     String?
  success_return_url String?
  cancel_return_url  String?
  merchant_accounts  MerchantAccount[]
  tenants            Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  system_logs        system_logs[]
  transactions       Transaction[]
  webhook_deliveries webhook_deliveries[]
  webhook_events     webhook_events[]

  @@index([tenant_id])
  @@map("stores")
}

model MerchantAccount {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String           @db.Uuid
  store_id             String?          @db.Uuid
  name                 String           @default("Unnamed Account")
  email                String?
  client_id            String
  client_secret        String
  shield_domain        String?
  proxy_url            String?
  daily_limit          Decimal          @default(5000.00) @db.Decimal(12, 2)
  current_volume       Decimal          @default(0.00) @db.Decimal(12, 2)
  priority             Int              @default(1)
  status               account_status   @default(ACTIVE)
  warmup_started_at    DateTime?        @db.Timestamptz(6)
  daily_limit_override Decimal?         @db.Decimal(12, 2)
  volume_reset_at      DateTime?        @db.Timestamptz(6)
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime         @default(now()) @db.Timestamptz(6)
  paypal_webhook_id    String?
  item_masking         Boolean          @default(false)
  fake_product_name    String           @default("Digital Service Upgrade")
  soft_limit           Decimal?         @default(4000.00) @db.Decimal(12, 2)
  display_profile_id   String?          @db.Uuid
  bundle_id            String?          @db.Uuid
  stores               Store?           @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  tenants              Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payment_display_profiles PaymentDisplayProfile? @relation(fields: [display_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  identity_bundles     PaymentIdentityBundle? @relation(fields: [bundle_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  system_logs          system_logs[]
  transactions         Transaction[]
  webhook_events       webhook_events[]

  @@index([tenant_id])
  @@index([tenant_id, status], map: "merchant_accounts_tenant_status_idx")
  @@index([tenant_id, store_id], map: "merchant_accounts_tenant_store_idx")
  @@index([display_profile_id], map: "merchant_accounts_display_profile_idx")
  @@index([bundle_id], map: "merchant_accounts_bundle_id_idx")
  @@map("merchant_accounts")
}

model Transaction {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                String               @db.Uuid
  store_id                 String               @db.Uuid
  merchant_id              String?              @db.Uuid
  original_amount          Decimal              @db.Decimal(12, 2)
  original_currency        String               @default("USD")
  original_item_name       String?
  masked_item_name         String               @default("Digital Service")
  gateway_fee              Decimal              @default(0.00) @db.Decimal(12, 2)
  status                   transaction_status   @default(PENDING)
  paypal_order_id          String?
  paypal_capture_id        String?
  authorization_id         String?
  intent                   String               @default("CAPTURE")
  customer_email           String?
  encrypted_card_number    String?
  encrypted_cvv            String?
  exp_month                String?
  exp_year                 String?
  card_last_4              String?
  card_brand               String?
  buyer_name               String?
  billing_address          Json?
  buyer_ip                 String?
  buyer_country            String?              @db.Char(2)
  ip_address               String?
  created_at               DateTime             @default(now()) @db.Timestamptz(6)
  updated_at               DateTime             @default(now()) @db.Timestamptz(6)
  authorized_at            DateTime?            @db.Timestamptz(6)
  completed_at             DateTime?            @db.Timestamptz(6)
  failed_at                DateTime?            @db.Timestamptz(6)
  refunded_at              DateTime?            @db.Timestamptz(6)
  disputed_at              DateTime?            @db.Timestamptz(6)
  canceled_at              DateTime?            @db.Timestamptz(6)
  checkout_expires_at      DateTime?            @db.Timestamptz(6)
  authorization_expires_at DateTime?            @db.Timestamptz(6)
  status_reason            String?
  merchant_success_url     String?
  merchant_cancel_url      String?
  billing_records          billing_records[]
  merchant_accounts        MerchantAccount?     @relation(fields: [merchant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stores                   Store                @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants                  Tenant               @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  webhook_deliveries       webhook_deliveries[]
  webhook_events           webhook_events[]

  @@index([status, authorization_expires_at(sort: Desc)], map: "transactions_auth_exp_idx")
  @@index([status, checkout_expires_at(sort: Desc)], map: "transactions_checkout_exp_idx")
  @@index([paypal_order_id], map: "transactions_paypal_order_idx")
  @@index([tenant_id, created_at(sort: Desc)], map: "transactions_tenant_created_idx")
  @@index([tenant_id])
  @@index([tenant_id, merchant_id], map: "transactions_tenant_merchant_idx")
  @@index([tenant_id, status], map: "transactions_tenant_status_idx")
  @@index([tenant_id, store_id], map: "transactions_tenant_store_idx")
  @@map("transactions")
}

model billing_records {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String      @db.Uuid
  transaction_id String      @db.Uuid
  gross_amount   Decimal     @db.Decimal(12, 2)
  fee_amount     Decimal     @db.Decimal(12, 2)
  net_amount     Decimal     @db.Decimal(12, 2)
  currency       String      @default("USD")
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  tenants        Tenant      @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions   Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "billing_records_tenant_idx")
  @@index([transaction_id], map: "billing_records_transaction_idx")
}

model email_change_codes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  new_email  String
  code       String   @db.Char(6)
  expires_at DateTime @default(dbgenerated("(now() + '00:10:00'::interval)")) @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "email_change_codes_user_idx")
}

model fraud_blocklist {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ip_address String   @unique(map: "fraud_blocklist_ip_idx") @db.Inet
  reason     String?
  blocked_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      User?    @relation(fields: [blocked_by], references: [id], onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model shield_domains {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain     String    @unique
  is_active  Boolean   @default(true)
  tenant_id  String?   @db.Uuid
  health_ok          Boolean   @default(true)
  last_check         DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)
  display_profile_id String?   @db.Uuid
  bundle_id          String?   @db.Uuid
  tenants            Tenant?   @relation(fields: [tenant_id], references: [id], onUpdate: NoAction)
  payment_display_profiles PaymentDisplayProfile? @relation(fields: [display_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  identity_bundles   PaymentIdentityBundle? @relation(fields: [bundle_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([bundle_id], map: "shield_domains_bundle_id_idx")
}

model system_logs {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action            String
  status            String           @default("OK")
  metadata          Json             @default("{}")
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  tenant_id         String?          @db.Uuid
  account_id        String?          @db.Uuid
  store_id          String?          @db.Uuid
  level             String           @default("info")
  merchant_accounts MerchantAccount? @relation(fields: [account_id], references: [id], onUpdate: NoAction)
  stores            Store?           @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  tenants           Tenant?          @relation(fields: [tenant_id], references: [id], onUpdate: NoAction)

  @@index([account_id], map: "system_logs_account_idx")
  @@index([action])
  @@index([created_at(sort: Desc)], map: "system_logs_created_idx")
  @@index([level])
  @@index([tenant_id], map: "system_logs_tenant_idx")
}

model system_settings {
  key        String   @id
  value      Json     @default("{}")
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model token_blacklist {
  jti                                     String   @id
  user_id                                 String?  @db.Uuid
  revoked_by                              String?  @db.Uuid
  reason                                  String?
  expires_at                              DateTime @db.Timestamptz(6)
  created_at                              DateTime @default(now()) @db.Timestamptz(6)
  users_token_blacklist_revoked_byTousers User?    @relation("token_blacklist_revoked_byTousers", fields: [revoked_by], references: [id], onUpdate: NoAction)
  users_token_blacklist_user_idTousers    User?    @relation("token_blacklist_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "token_blacklist_expires_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model webhook_deliveries {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id              String         @db.Uuid
  transaction_id        String         @db.Uuid
  tenant_id             String         @db.Uuid
  store_id              String         @db.Uuid
  target_url            String
  headers_sent          Json           @default("{}")
  raw_payload           String
  http_status           Int?
  response_body_snippet String?
  error_message         String?
  attempt_number        Int
  trigger_origin        String         @default("automatic")
  final_status          String         @default("pending")
  next_retry_at         DateTime?      @db.Timestamptz(6)
  delivered_at          DateTime?      @db.Timestamptz(6)
  created_at            DateTime       @default(now()) @db.Timestamptz(6)
  webhook_events        webhook_events @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stores                Store          @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants               Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transactions          Transaction    @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([event_id, attempt_number(sort: Desc)], map: "webhook_deliveries_event_idx")
  @@index([store_id, created_at(sort: Desc)], map: "webhook_deliveries_store_idx")
  @@index([transaction_id, created_at(sort: Desc)], map: "webhook_deliveries_tx_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model webhook_events {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id          String               @db.Uuid
  tenant_id               String               @db.Uuid
  store_id                String               @db.Uuid
  account_id              String?              @db.Uuid
  event_name              String
  business_key            String               @unique
  target_url              String
  raw_payload             String
  payload_version         String               @default("2026-04-08")
  source                  String               @default("system")
  trigger_origin          String               @default("automatic")
  delivery_status         String               @default("pending")
  attempt_count           Int                  @default(0)
  last_delivery_id        String?              @db.Uuid
  latest_http_status      Int?
  latest_response_snippet String?
  latest_error            String?
  last_attempt_at         DateTime?            @db.Timestamptz(6)
  next_retry_at           DateTime?            @db.Timestamptz(6)
  delivered_at            DateTime?            @db.Timestamptz(6)
  replayed_at             DateTime?            @db.Timestamptz(6)
  canceled_at             DateTime?            @db.Timestamptz(6)
  created_at              DateTime             @default(now()) @db.Timestamptz(6)
  updated_at              DateTime             @default(now()) @db.Timestamptz(6)
  webhook_deliveries      webhook_deliveries[]
  merchant_accounts       MerchantAccount?     @relation(fields: [account_id], references: [id], onUpdate: NoAction)
  stores                  Store                @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants                 Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transactions            Transaction          @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([store_id, delivery_status, next_retry_at], map: "webhook_events_store_status_idx")
  @@index([tenant_id, created_at(sort: Desc)], map: "webhook_events_tenant_created_idx")
  @@index([transaction_id, created_at(sort: Desc)], map: "webhook_events_transaction_idx")
}

enum account_status {
  ACTIVE
  PAUSED
  WARMING_UP
  SUSPENDED
}

enum transaction_status {
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
  DISPUTED
  CANCELED
  EXPIRED
}

enum user_role {
  SUPER_ADMIN
  MERCHANT
}

model PaymentDisplayProfile {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String   @db.Uuid
  store_id           String?  @db.Uuid
  profile_name       String
  industry_vertical  String
  public_brand_name  String?
  descriptor_prefix  String?
  display_mode       String   @default("BRAND_SEMANTIC")
  line_item_policy   String   @default("SINGLE_SEMANTIC_ITEM")
  is_default         Boolean  @default(false)
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)
  merchant_accounts  MerchantAccount[]
  shield_domains     shield_domains[]

  @@index([tenant_id])
  @@index([store_id])
  @@map("payment_display_profiles")
}

model PaymentDescriptorTemplate {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  industry_vertical  String
  descriptor_text    String
  is_active          Boolean  @default(true)
  sort_order         Int      @default(0)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([industry_vertical])
  @@map("payment_descriptor_templates")
}

model PaymentIdentityBundle {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String   @db.Uuid
  store_id            String?  @db.Uuid
  display_profile_id  String?  @db.Uuid
  bundle_name         String
  public_brand_name   String?
  industry_vertical   String
  primary_shield_domain String?
  support_email       String?
  support_phone       String?
  order_lookup_url    String?
  tracking_url        String?
  shipping_policy_url String?
  refund_policy_url   String?
  privacy_policy_url  String?
  terms_url           String?
  is_default          Boolean  @default(false)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
  items               PaymentIdentityBundleItem[]
  merchant_accounts   MerchantAccount[]
  shield_domains      shield_domains[]

  @@index([tenant_id], map: "pib_tenant_id_idx")
  @@index([store_id], map: "pib_store_id_idx")
  @@index([display_profile_id], map: "pib_display_profile_id_idx")
  @@index([tenant_id, store_id, is_default, is_active], map: "pib_tenant_store_default_idx")
  @@map("payment_identity_bundles")
}

model PaymentIdentityBundleItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String   @db.Uuid
  bundle_id           String   @db.Uuid
  descriptor_name     String
  product_slug        String?
  product_title       String
  product_description String?
  product_type        String   @default("physical_good")
  shipping_required   Boolean  @default(true)
  tracking_expected   Boolean  @default(true)
  price_min           Decimal? @db.Decimal(12, 2)
  price_max           Decimal? @db.Decimal(12, 2)
  image_url           String?
  is_active           Boolean  @default(true)
  sort_order          Int      @default(0)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
  bundle              PaymentIdentityBundle @relation(fields: [bundle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bundle_id, is_active, sort_order], map: "pibi_bundle_active_sort_idx")
  @@index([tenant_id], map: "pibi_tenant_id_idx")
  @@map("payment_identity_bundle_items")
}
